# ------------------------------------------------------------------
# Kopiraj ovaj fajl u .env.local i upisi prave vrijednosti.
#   cp .env.example .env.local
# .env.local NIKAD ne ide na GitHub (vec je u .gitignore).
# ------------------------------------------------------------------

# Supabase > Project Settings > API
# NEXT_PUBLIC_ znaci da je vidljivo u pregledniku. To je u redu za URL i publishable kljuc.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# TAJNI kljuc. Zaobilazi RLS pravila. Koristi se SAMO na serveru
# (server actions), nikad u komponenti koja ima "use client".
# Stariji projekti ga zovu "service_role".
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxx

# Resend > API Keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxx

# Na koji mail stizu prijave (Adnanov)
APPLICATIONS_TO_EMAIL=adnan@example.com

# S kojeg maila se salje (mora biti na domeni verifikovanoj u Resendu)
EMAIL_FROM="Adnan Gosto <prijave@adnangosto.com>"

# Puna adresa sajta, za linkove u mailovima i SEO
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Behold.so > feed (JSON) > Feed URL. Bez njega Instagram sekcija prikazuje lokalne fotografije.
BEHOLD_FEED_URL=
